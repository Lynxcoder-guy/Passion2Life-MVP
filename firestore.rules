rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // PROJECTS COLLECTION
    // Any signed-in user can create, read, update, and delete projects.
    // This is the collection used by: newproject.jsx, home.jsx,
    // passionproject.jsx, newtaskform.jsx, scoring.jsx
    // ------------------------------------------------------------
    match /projects/{projectId} {
      // A project can only be created by the user whose uid is stored
      // in the new document ("uid" is set by newproject.jsx).
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // After creation, only the owner can read, update, or delete it.
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Notes subcollection (projects/{id}/notes)
      match /notes/{noteId} {
        allow read, write: if request.auth != null;
      }
    }

    // ------------------------------------------------------------
    // DEVICES COLLECTION
    // Used by login.jsx to track which browser/device belongs to a user.
    // ------------------------------------------------------------
    match /devices/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // ------------------------------------------------------------
    // USER DEVICES COLLECTION
    // Used by login.jsx to link a user to their device(s).
    // ------------------------------------------------------------
    match /userDevices/{uid} {
      allow read, write: if request.auth != null;
    }
  }
}